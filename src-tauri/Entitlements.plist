<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The bundled easy-console-cli / easy-console-mcp sidecars are packaged
		Node.js executables. Tauri signs them with these entitlements under the
		hardened runtime, where V8 cannot allocate JIT memory without both keys
		and the process dies with SIGTRAP on its first instruction.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
